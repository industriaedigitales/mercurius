{
  "appId": "com.industriaedigitales.mercurius",
  "files": ["dist-electron", "dist-react"],
  "extraResources": [
    "dist-electron/preload.cjs",
    "src/assets/**",
    {
      "from": "dist-server/server.mjs",
      "to": "server/server.mjs"
    }
  ],
  "icon": "./desktopIcon.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "target": ["portable", "msi"]
  }
}
