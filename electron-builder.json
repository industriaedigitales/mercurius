{
  "appId": "com.industriaedigitales.mercurius",
  "productName": "Mercurius",
  "copyright": "Copyright © 2025 Luca Pulina",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "publish": {
    "provider": "github",
    "owner": "industriaedigitales",
    "repo": "mercurius"
  },
  "files": [
    "dist-electron/**/*",
    "dist-react/**/*",
    "src/assets/**/*",
    "src/ui/shared/locales/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist-server/server.mjs",
      "to": "server/server.mjs"
    },
    {
      "from": "dist-react",
      "to": "web-client"
    }
  ],
  "icon": "build/icon.png",
  "mac": {
    "category": "public.app-category.utilities",
    "target": ["dir", "zip", "dmg"],
    "identity": null
  },
  "dmg": {
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      {
        "x": 130,
        "y": 190
      },
      {
        "x": 410,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Mercurius",
    "runAfterFinish": true
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Utility"
  }
}
