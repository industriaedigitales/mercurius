{
  "name": "mercurius",
  "private": true,
  "version": "0.2.2",
  "description": "Mercurius - a local file transfer application.",
  "author": "Luca Pulina <lucapulina@gmail.com>",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/industriaedigitales/mercurius.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "start": "cross-env NODE_ENV=production electron .",
    "build:server": "node scripts/build-server.js",
    "transpile:electron": "tsc -project src/electron/tsconfig.json",
    "build": "npm run build:server && tsc -b && vite build",
    "build:all": "npm run build:server && npm run transpile:electron && tsc -b && vite build",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist:win": "npm run build:all && electron-builder --win --x64",
    "dist:linux": "npm run build:all && electron-builder --linux --x64",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@tailwindcss/vite": "^4.1.16",
    "electron-log": "^5.4.3",
    "file-upload": "^0.0.0",
    "hono": "^4.10.4",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "localtunnel": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.3.5",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.9.6",
    "tailwindcss": "^4.1.16",
    "ua-parser-js": "^2.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^10.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.15"
  }
}
